# rust
target/
Cargo.lock
**/target/
# The Solana program is built by the cargo inside the Agave platform tools
# (1.84), which cannot parse edition-2024 manifests; its lock file is kept so
# the SBF build does not drift onto crates that toolchain cannot read.
!solana/Cargo.lock

# foundry
evm/out/
evm/cache/
evm/broadcast/
evm/deployments/
evm/lib/

# move / sui / aptos
build/
sui/build/
aptos/build/

# anchor
solana/target/
solana/.anchor/

# ton
ton/*.fif
ton/*.cell

# cairo
cairo/target/

# wasm artifacts
*.wasm

# cairo
cairo/target/

# node
node_modules/
wallet/dist/
wallet/src-tauri/target/
wallet/serve.log
wallet/serve.err
wallet/package-lock.json
wallet/lh-local.json
wallet/lighthouse-mobile.json

# env
.env
.env.*
!.env.example

# os
.DS_Store
Thumbs.db

deploy/.deployer-key.local
