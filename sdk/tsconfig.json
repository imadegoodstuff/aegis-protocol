{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"],
    // Type-check only: the bundled sources import viem from wallet/node_modules;
    // examples and scripts must see the same declarations, not sdk/node_modules' copy.
    "paths": {
      "viem": ["../wallet/node_modules/viem"],
      "viem/*": ["../wallet/node_modules/viem/_types/*/index.d.ts"]
    }
  },
  "include": ["src", "scripts", "examples", "../wallet/src/aegis"]
}
